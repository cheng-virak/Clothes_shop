node_modules/
dist/
build/
*.log
.DS_Store

# Secrets. `.env` alone only matches a file named exactly that — a file
# like `atlas-credentials.env` or `prod.env` would have sailed straight
# into a commit, so match any *.env and any *credentials* file instead.
# `.env.example` is deliberately still tracked: it ends in `.example`, so
# it doesn't match `*.env`, and the negation below makes that explicit.
*.env
*.env.*
!*.env.example
*credentials*
*secrets*

# Uploaded product images ARE committed: the seeded products reference
# these exact filenames, so a fresh clone would otherwise render the demo
# with broken images. Real deployments should point multer at object
# storage instead of serving user uploads out of the repo.

# Local DB backups taken before migrations — not meant to be committed
backend/backups/
