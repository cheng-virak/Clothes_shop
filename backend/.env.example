# Server
PORT=5000
NODE_ENV=development
# Comma-separated allowlist — the storefront (:5173) and admin (:5174) dev
# servers. Add each real deployed origin here too; never a wildcard.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MySQL - local development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=shope_clothes
DB_CONNECTION_LIMIT=10

# MySQL - hosted (Railway / Aiven / PlanetScale / etc).
# DATABASE_URL replaces the five DB_* vars above; set one or the other.
# Hosted MySQL always requires TLS, so set DB_SSL=true alongside it.
# DATABASE_URL=mysql://user:password@host:3306/shope_clothes
# DB_SSL=true
#
# Only needed for providers that issue their own CA rather than one that
# chains to a public root (Aiven does; Railway and PlanetScale don't):
# DB_SSL_CA_PATH=./certs/ca.pem

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
