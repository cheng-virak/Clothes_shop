# Server
PORT=5000
NODE_ENV=development
# Comma-separated allowlist — the storefront (:5173) and admin (:5174) dev
# servers. Add each real deployed origin here too; never a wildcard.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB — the connection string from Atlas (Database -> Connect -> Drivers).
# In Atlas, Network Access must allow the IP this backend runs from.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shope_clothes

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
