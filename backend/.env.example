# Server
PORT=5000
NODE_ENV=development
# Comma-separated allowlist — the storefront (:5173) and admin (:5174) dev
# servers. Never a wildcard.
#
# In production the two clients are separate Vercel projects on separate
# domains, so every request to this API is cross-origin and each of those
# domains MUST be listed here or the browser blocks it:
#
#   CORS_ORIGINS=https://<storefront>.vercel.app,https://<admin>.vercel.app
#
# Preview deployments get a new URL per commit, so they aren't covered by
# this list — add one explicitly when you need to test against it.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL — the connection string from Neon (Dashboard -> Connect).
# Use the POOLED endpoint: its host contains "-pooler". The direct
# (non-pooled) host opens one backend per connection and runs out fast
# when several serverless instances are warm.
#
# `channel_binding=require` in Neon's copy-paste string is a libpq option;
# node-postgres ignores it, which is harmless. TLS is not left to the URL
# either — src/config/db.js sets ssl explicitly so the server certificate
# is actually verified (see the comment there).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Per serverless instance, not per deployment — keep it small.
DATABASE_POOL_SIZE=5

# Product image storage.
#
# Leave this unset locally: uploads then go to backend/uploads on disk and
# are served at /uploads, which needs no accounts or setup.
#
# On Vercel it must NOT be unset, and you don't set it by hand — connect a
# Blob store to the project (Storage -> Blob) and Vercel injects it. A
# function's filesystem is read-only, so without a Blob store the admin's
# image upload returns a 500 in production. See src/storage/.
# BLOB_READ_WRITE_TOKEN=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
