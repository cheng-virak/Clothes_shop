# Where the storefront dev server's /api and /uploads proxy forwards to.
# Read by vite.config.js at dev-server start — not bundled into client JS.
VITE_API_TARGET=http://localhost:5000

# Bundled into the client — visible to anyone who opens dev tools. Never
# put a secret in a VITE_* variable.
#
# Left as the relative /api locally, where the dev proxy above handles it.
# In production the storefront and the API are separate Vercel projects on
# separate domains, so this must be set to the API's absolute URL:
#
#   VITE_API_BASE_URL=https://<your-api-project>.vercel.app/api
#
# Set it in the Vercel project's Environment Variables, and add this
# storefront's own domain to the API's CORS_ORIGINS — without that the
# browser blocks every cross-origin request.
VITE_API_BASE_URL=/api
