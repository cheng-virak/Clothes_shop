# Where the admin dev server's /api and /uploads proxy forwards to.
# Read by vite.config.js at dev-server start — not bundled into client JS.
VITE_API_TARGET=http://localhost:5000

# Bundled into the client — visible to anyone who opens dev tools. Never
# put a secret in a VITE_* variable. Used if/when the app calls the API
# directly instead of through the dev proxy (e.g. a production build
# served from a different host than the API).
VITE_API_BASE_URL=/api

# Shown as a badge in the admin header so nobody mistakes a non-local
# environment for local. One of: LOCAL, STAGING, PRODUCTION.
VITE_ENV_LABEL=LOCAL

# "View storefront" link target in the admin header.
VITE_STOREFRONT_URL=http://localhost:5173
